# ComplianceGuardian — environment variables
# Copy to .env for local development. NEVER commit .env.
# Deployed environments read these from Google Secret Manager (see infra/terraform/iam.tf).

# --- Google Cloud project ---
GOOGLE_CLOUD_PROJECT=cg-local

# --- Local emulators (docker-compose.emulators.yml) ---
# When set, all shared clients route to emulators instead of live GCP.
FIRESTORE_EMULATOR_HOST=localhost:8085
STORAGE_EMULATOR_HOST=http://localhost:4443
BIGQUERY_EMULATOR_HOST=http://localhost:9050
# Firebase Auth emulator (Phase 3, via `npx firebase-tools emulators:start --only auth`)
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- Storage ---
GCS_BUCKET_RAW_DOCS=cg-local-cg-raw-docs
GCS_BUCKET_REPORTS=cg-local-cg-reports

# --- BigQuery ---
BQ_DATASET_AUDIT=compliance_audit
BQ_TABLE_AUDIT_LOGS=audit_logs
BQ_TABLE_REPORTS=reports

# --- Gemini (Phase 2+) ---
# Google AI Studio API key. In deployed envs this comes from Secret Manager, not env files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Business logic ---
RISK_ESCALATION_THRESHOLD=60

# --- Cloud Tasks (Phase 2+; local dev dispatches inline) ---
CLOUD_TASKS_QUEUE=cg-task-queue
CLOUD_TASKS_LOCATION=us-central1
