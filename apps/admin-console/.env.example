# Operator console configuration. Copy to .env.local for local dev.
VITE_API_BASE_URL=http://localhost:8080
VITE_GCP_PROJECT=cg-local

# Firebase web config — public identifiers, not secrets. Access is decided by
# the server-side operator allowlist, not by anything in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
