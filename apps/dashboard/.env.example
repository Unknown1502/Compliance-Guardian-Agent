# ComplianceGuardian dashboard — Vite env. Copy to .env.local for local dev.
# VITE_ vars are embedded at build time.

# API Gateway base URL
VITE_API_BASE_URL=http://localhost:8080

# Auth mode: "dev" uses local base64 claim tokens against the API gateway's
# CG_AUTH_DEV_MODE (no Firebase Auth emulator / Java needed). "firebase" uses
# real Firebase Auth. Production always uses "firebase".
VITE_AUTH_MODE=dev

# GCP project (used for Firestore real-time reads)
VITE_GCP_PROJECT=cg-local

# Firestore emulator host for local real-time reads (dev only). Leave blank in prod.
VITE_FIRESTORE_EMULATOR_HOST=localhost:8085

# Firebase web config (required when VITE_AUTH_MODE=firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
