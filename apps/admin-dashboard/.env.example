# API Gateway the console talks to.
VITE_API_BASE_URL=https://cg-api-gateway-fxwkr4y3oq-uc.a.run.app

# Firebase web config — the SAME Firebase project as the customer app, because
# authentication and the backend are shared. Only the hosting site and the
# frontend build are separate. Authorization is enforced server-side.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
